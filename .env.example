RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=you@example.com
LEAD_FROM_EMAIL=South Coast Quality Painting Inc <leads@quicklaunchweb.us>
SITE_URL=https://www.southcoastqualitypaint.com
ALLOWED_ORIGINS=https://www.southcoastqualitypaint.com,https://southcoastqualitypaint.com

# ---- GoHighLevel (lead automation) ----
# Leads are upserted as contacts auto-tagged "website-form" so the
# GHL workflow can fire. If these are unset the push is skipped and the
# lead email still sends.
GHL_API_KEY=
GHL_LOCATION_ID=
# Set to v1 only if you are using a legacy rest.gohighlevel.com key.
GHL_API_VERSION=v2
# Optional: also open an opportunity in a pipeline.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional: map our fields to GHL custom field IDs, e.g.
# {"lead_tier":"AbC123","service":"DeF456","timeline":"GhI789"}
GHL_CUSTOM_FIELDS=

# ---- Spam defense ----
# Comma-separated origins allowed to POST /api/send. Submissions from any
# other origin are rejected. Leave blank to disable the check.
# ALLOWED_ORIGINS is already set above.
#
# Optional Cloudflare Turnstile. Leave blank and the check is skipped;
# set both to enable an invisible challenge.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
